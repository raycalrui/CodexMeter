    "about.privacy_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quota and token history stays on this Mac. CodexMeter stores no account email, authentication token, or raw App Server response and includes no analytics."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额度和 Token 历史只保存在这台 Mac。CodexMeter 不保存账户邮箱、认证 Token 或 App Server 原始响应，也不包含分析追踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "額度和 Token 歷史只儲存在這台 Mac。CodexMeter 不儲存帳戶電子郵件、認證 Token 或 App Server 原始回應，也不包含分析追蹤。"
          }
        }
      }
    },
